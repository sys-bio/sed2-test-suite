{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sys-bio/sed2-test-suite/schemas/disagreements.schema.json",
  "title": "SED2 test suite disagreement log (disagreements.json)",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "test", "backends", "status", "diagnosis", "resolution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^D-\\d{3,}$" },
        "test": { "type": "string", "pattern": "^\\d{5}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "backends": {
          "description": "The backends (or 'expected' for the case's recorded results) that disagree; at least two.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "report": { "description": "Report id the difference was found in; omit for a failure that has no report.", "type": "string" },
        "size": {
          "description": "How big the difference is; omit if the results could not be compared.",
          "type": "object",
          "required": ["maxAbsolute", "maxRelative"],
          "additionalProperties": false,
          "properties": {
            "maxAbsolute": { "type": ["number", "string"], "description": "A number, or 'inf'." },
            "maxRelative": { "type": ["number", "string"], "description": "A number, or 'inf'." },
            "where": { "type": "string" }
          }
        },
        "symptom": { "description": "What was seen, in words.", "type": "string" },
        "status": { "enum": ["open", "resolved", "wontfix"] },
        "diagnosis": {
          "enum": ["undiagnosed", "solver setting", "translator bug", "simulator bug", "spec ambiguity"]
        },
        "resolution": {
          "description": "What was done, or what is waiting; required to be non-empty once status is not 'open'.",
          "type": "string"
        },
        "reference": { "description": "Where to look: issue, commit, SED2/TODO.md item, spec section.", "type": "string" }
      }
    }
  }
}
