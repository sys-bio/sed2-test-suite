<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model metaid="params" id="params">
    <listOfParameters>
      <parameter id="x" value="1" constant="false"/>
      <parameter id="r" value="0.25" constant="true"/>
      <parameter id="z" constant="false"/>
      <parameter id="y" value="5" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <rateRule variable="x">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> r </ci>
            <ci> x </ci>
          </apply>
        </math>
      </rateRule>
      <assignmentRule variable="z">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn type="integer"> 2 </cn>
              <ci> x </ci>
            </apply>
            <cn type="integer"> 1 </cn>
          </apply>
        </math>
      </assignmentRule>
      <rateRule variable="y">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 3 </cn>
        </math>
      </rateRule>
    </listOfRules>
  </model>
</sbml>
