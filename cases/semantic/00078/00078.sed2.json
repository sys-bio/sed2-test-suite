{
  "version": "v1.0.0",
  "constants": {
    "m": [
      [
        1,
        2,
        3
      ],
      [
        4,
        5,
        6
      ]
    ],
    "n": [
      [
        10,
        20,
        30
      ],
      [
        40,
        50,
        60
      ]
    ]
  },
  "tasks": {
    "add": {
      "_type": "calculation",
      "math": "#constants:m + #constants:n"
    },
    "mul": {
      "_type": "calculation",
      "math": "#constants:m * #constants:n"
    }
  },
  "outputs": {
    "add": {
      "_type": "report",
      "data": "#tasks:add"
    },
    "mul": {
      "_type": "report",
      "data": "#tasks:mul"
    }
  }
}
