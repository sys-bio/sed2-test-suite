{
  "version": "v1.0.0",
  "constants": {
    "k": 2.5,
    "third": 0.3333333333333333,
    "n": 3.0,
    "neg": -2,
    "big": 1234567,
    "small": 0.125
  },
  "tasks": {
    "lit": {
      "_type": "stringFormation",
      "concatenate": [
        "a",
        3,
        "b",
        2.5,
        "c",
        -2,
        "d",
        0.1,
        "e",
        100
      ]
    },
    "ref": {
      "_type": "stringFormation",
      "concatenate": [
        "k=",
        "#constants:k",
        " third=",
        "#constants:third",
        " n=",
        "#constants:n",
        " neg=",
        "#constants:neg",
        " big=",
        "#constants:big",
        " small=",
        "#constants:small"
      ]
    },
    "float": {
      "_type": "stringFormation",
      "concatenate": [
        "v",
        4.0
      ]
    }
  },
  "outputs": {
    "lit": {
      "_type": "report",
      "data": "#tasks:lit"
    },
    "ref": {
      "_type": "report",
      "data": "#tasks:ref"
    },
    "float": {
      "_type": "report",
      "data": "#tasks:float"
    }
  }
}
