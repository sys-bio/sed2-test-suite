<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model metaid="logistic" id="logistic">
    <listOfParameters>
      <parameter id="x" value="1" constant="false"/>
      <parameter id="r" value="0.5" constant="true"/>
      <parameter id="K" value="10" constant="true"/>
    </listOfParameters>
    <listOfRules>
      <rateRule variable="x">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> r </ci>
            <ci> x </ci>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <apply>
                <divide/>
                <ci> x </ci>
                <ci> K </ci>
              </apply>
            </apply>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
  </model>
</sbml>
