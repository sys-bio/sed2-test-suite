{
  "version": "v1.0.0",
  "tasks": {
    "sc": {
      "_type": "scatter",
      "range": {
        "_type": "numericRange",
        "start": 0,
        "numberOfSteps": 1,
        "interval": 1
      },
      "subTasks": {
        "x": {
          "_type": "stringFormation",
          "concatenate": [
            "n=",
            "#tasks:sc.index"
          ]
        }
      },
      "outputVariableMap": {
        "X": "#tasks:sc:subTasks:x"
      }
    }
  },
  "outputs": {
    "r": {
      "_type": "report",
      "data": "#tasks:sc"
    }
  }
}
