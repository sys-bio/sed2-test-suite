{
  "version": "v1.0.0",
  "constants": {
    "v": [
      10,
      20,
      30,
      40,
      50
    ],
    "m": [
      [
        1,
        2,
        3
      ],
      [
        4,
        5,
        6
      ]
    ]
  },
  "tasks": {
    "ends": {
      "_type": "calculation",
      "math": "#constants:v[0] + #constants:v[-1]"
    },
    "slice": {
      "_type": "calculation",
      "math": "#constants:v[1:3] * 2"
    },
    "rows": {
      "_type": "calculation",
      "math": "#constants:m[0] * #constants:m[1]"
    },
    "col": {
      "_type": "calculation",
      "math": "#constants:m[0:2, 1] + 1"
    },
    "elem": {
      "_type": "calculation",
      "math": "#constants:m[1, 2] ^ 2"
    }
  },
  "outputs": {
    "ends": {
      "_type": "report",
      "data": "#tasks:ends"
    },
    "slice": {
      "_type": "report",
      "data": "#tasks:slice"
    },
    "rows": {
      "_type": "report",
      "data": "#tasks:rows"
    },
    "col": {
      "_type": "report",
      "data": "#tasks:col"
    },
    "elem": {
      "_type": "report",
      "data": "#tasks:elem"
    }
  }
}
