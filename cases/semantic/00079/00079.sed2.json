{
  "version": "v1.0.0",
  "constants": {
    "v": [
      1,
      2,
      3
    ],
    "m": [
      [
        1,
        2,
        3
      ],
      [
        4,
        5,
        6
      ]
    ]
  },
  "tasks": {
    "mul": {
      "_type": "calculation",
      "math": "#constants:v * #constants:m"
    },
    "add": {
      "_type": "calculation",
      "math": "#constants:m + #constants:v"
    },
    "sub": {
      "_type": "calculation",
      "math": "#constants:m - #constants:v"
    }
  },
  "outputs": {
    "mul": {
      "_type": "report",
      "data": "#tasks:mul"
    },
    "add": {
      "_type": "report",
      "data": "#tasks:add"
    },
    "sub": {
      "_type": "report",
      "data": "#tasks:sub"
    }
  }
}
