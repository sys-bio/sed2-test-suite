{
  "version": "v1.0.0",
  "constants": {
    "m": [
      [
        1,
        2
      ],
      [
        3,
        4
      ]
    ],
    "t": [
      [
        "a",
        "b"
      ],
      [
        "c",
        "d"
      ]
    ]
  },
  "tasks": {
    "grid": {
      "_type": "stringFormation",
      "concatenate": [
        "r",
        "#constants:m",
        "c",
        "#constants:t"
      ]
    }
  },
  "outputs": {
    "grid": {
      "_type": "report",
      "data": "#tasks:grid"
    }
  }
}
