{
  "version": "v1.0.0",
  "constants": {
    "ks": [
      0.25,
      0.5,
      1
    ]
  },
  "tasks": {
    "m": {
      "_type": "modelImport",
      "location": "00248.sbml",
      "language": "urn:sedml:language:sbml"
    },
    "ps": {
      "_type": "parameterScan",
      "model": "#tasks:m.model",
      "parameterRanges": [
        {
          "_type": "parameterRange",
          "modelElement": "k1",
          "values": [
            0.25,
            0.5,
            1
          ]
        }
      ],
      "subTasks": {
        "s": {
          "_type": "oneStepODESimulation",
          "model": "#tasks:ps.model",
          "independentVariable": "urn:sedml:symbol:time",
          "outputVariables": [
            "S"
          ],
          "independentStep": 1
        }
      },
      "outputVariableMap": {
        "S": "#tasks:ps:subTasks:s['S']"
      }
    }
  },
  "outputs": {
    "r": {
      "_type": "report",
      "data": "#tasks:ps"
    },
    "p": {
      "_type": "plot2D",
      "curves": {
        "c": {
          "_type": "curve",
          "curveType": "points",
          "x": "#constants:ks",
          "y": "#tasks:ps[:, 'S']"
        }
      }
    }
  }
}
