<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model metaid="stiff" id="stiff">
    <listOfParameters>
      <parameter id="x" value="1" constant="false"/>
      <parameter id="y" value="0" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <rateRule variable="x">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <cn type="integer"> -1000 </cn>
            <ci> x </ci>
          </apply>
        </math>
      </rateRule>
      <rateRule variable="y">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci> y </ci>
            </apply>
            <ci> x </ci>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
  </model>
</sbml>
